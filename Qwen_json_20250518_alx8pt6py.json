{
  "name": "laravel/laravel",
  "type": "project",
  "description": "Gestion des courriers",
  "keywords": ["courrier", "direction", "traitement", "gestion documentaire"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0",
    "laravel/ui": "^4.2",
    "spatie/laravel-permission": "^5.11",
    "barryvdh/laravel-dompdf": "^2.0",
    "twilio/sdk": "^7.17"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunzion/pest-plugin-laravel": "^0.4.1",
    "pestphp/pest": "^2.24",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php vendor/bin/pest --colors=always || true"
    ],
    "install": [
      "@php artisan key:generate --ansi"
    ],
    "dev": "npm run dev",
    "build": "npm run build"
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}